diff --git a/tools/mtmd/clip.cpp b/tools/mtmd/clip.cpp
index b8f0b94..c93a494 100644
--- a/tools/mtmd/clip.cpp
+++ b/tools/mtmd/clip.cpp
@@ -4427,6 +4427,22 @@ void clip_free(clip_ctx * ctx) {
     delete ctx;
 }
 
+const char * clip_backend_name(const struct clip_ctx * ctx) {
+    return ctx && ctx->backend ? ggml_backend_name(ctx->backend) : nullptr;
+}
+
+bool clip_backend_is_gpu(const struct clip_ctx * ctx) {
+    if (!ctx || !ctx->backend) {
+        return false;
+    }
+    ggml_backend_dev_t device = ggml_backend_get_device(ctx->backend);
+    if (!device) {
+        return false;
+    }
+    const enum ggml_backend_dev_type type = ggml_backend_dev_type(device);
+    return type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU;
+}
